{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/poem/:slug",
      "destination": "/api/poetry-page?slug=:slug"
    },
    {
      "source": "/poems",
      "destination": "/api/poetry-page"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
